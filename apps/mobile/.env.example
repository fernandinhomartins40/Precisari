# Precisari mobile (Expo). Copy to apps/mobile/.env — EXPO_PUBLIC_* values are inlined into the bundle.

# true = use the in-app fake API (src/lib/mock-api.ts) with demo data. No server needed. Any 6-digit OTP works.
EXPO_PUBLIC_API_MOCK=true

# Real API base URL (without /v1). Used when EXPO_PUBLIC_API_MOCK is not "true".
# On a physical phone (Expo Go) use your computer's LAN IP, never localhost, e.g. http://192.168.0.10:3333
EXPO_PUBLIC_API_URL=http://localhost:3333

# Web app base URL: "Assinar Pro" opens the web checkout in the browser (no in-app sales, store rules).
EXPO_PUBLIC_WEB_URL=http://localhost:3001
