    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@precisari/pricing-engine": "workspace:*",
    "@precisari/shared": "workspace:*",
    "@prisma/client": "^6.19.0",
    "bullmq": "^5.61.0",
    "ioredis": "^5.8.0",
    "jose": "^5.10.0",
    "nestjs-pino": "^4.4.1",
    "node-ical": "^0.21.0",
    "pino": "^9.13.0",
