# Precisari web (Next.js). Copy to apps/web/.env.local.
#
# Mock mode: when "true" (the default when unset), the web app talks to an in-browser fake API
# (src/lib/mock-api.ts) that implements the /v1 contract with demo data ("Studio do Campeche").
# Any e-mail works and any 6-digit code (e.g. 123456) logs in. Used for local preview and E2E.
# E-mails starting with "admin" get the ADMIN role (unlocks /admin).
NEXT_PUBLIC_API_MOCK=true

# Real API base URL (without /v1). Used when NEXT_PUBLIC_API_MOCK=false.
NEXT_PUBLIC_API_URL=http://localhost:3333
