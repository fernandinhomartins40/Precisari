# ---------- API (apps/api) ----------
NODE_ENV=development
API_PORT=3333
API_PUBLIC_URL=http://localhost:3333
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
DATABASE_URL=postgresql://precisari:precisari@localhost:5432/precisari?schema=public
REDIS_URL=redis://localhost:6379
# JWT (access token curto + refresh rotativo)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Criptografia de URLs iCal e tokens Channex (32 bytes em base64: openssl rand -base64 32)
DATA_ENCRYPTION_KEY=
# OTP
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
# Em desenvolvimento o código OTP é impresso no log quando EMAIL_PROVIDER=fake
# Admins (e-mails separados por vírgula recebem role ADMIN no login)
ADMIN_EMAILS=
# Jobs: desliga o agendamento BullMQ (útil em testes)
JOBS_ENABLED=true

# ---------- Integrações (vazio = adapter fake) ----------
EMAIL_PROVIDER=fake            # fake | resend
RESEND_API_KEY=
EMAIL_FROM="Precisari <ola@precisari.com.br>"
HOLIDAYS_PROVIDER=brasilapi    # brasilapi | fake
WEATHER_PROVIDER=open-meteo    # open-meteo | fake
OPEN_METEO_BASE_URL=https://api.open-meteo.com
GEO_PROVIDER=fake              # google | fake
GOOGLE_MAPS_API_KEY=
LLM_PROVIDER=fake              # anthropic | fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
PUSH_PROVIDER=fake             # expo | fake
EXPO_ACCESS_TOKEN=
BILLING_PROVIDER=fake          # fake (gateway a definir: asaas | mercadopago | pagarme | stripe)
BILLING_WEBHOOK_SECRET=change-me-webhook-secret
CHANNEX_PROVIDER=fake          # channex | fake (fase 2)
CHANNEX_BASE_URL=https://staging.channex.io/api/v1
CHANNEX_API_KEY=
SENTRY_DSN=
# Login social (TODO: credenciais)
APPLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# ---------- Web (apps/web) ----------
NEXT_PUBLIC_API_URL=http://localhost:3333

# ---------- Mobile (apps/mobile) ----------
EXPO_PUBLIC_API_URL=http://localhost:3333
