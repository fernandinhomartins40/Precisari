# ---------- API (apps/api) ----------
NODE_ENV=development
API_PORT=3333
API_PUBLIC_URL=http://localhost:3333
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
DATABASE_URL=postgresql://precisari:precisari@localhost:5432/precisari?schema=public
REDIS_URL=redis://localhost:6379
# JWT (access token curto + refresh rotativo)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Criptografia de URLs iCal e tokens Channex (32 bytes em base64: openssl rand -base64 32)
DATA_ENCRYPTION_KEY=
# OTP
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
# Em desenvolvimento o código OTP é impresso no log quando EMAIL_PROVIDER=fake
# Admins (e-mails separados por vírgula recebem role ADMIN no login)
ADMIN_EMAILS=
# Conta de revisão da App Store / Play: esse e-mail entra com esse código fixo de 6 dígitos, sem e-mail. Vazio = desligado
REVIEW_LOGIN_EMAIL=
REVIEW_LOGIN_CODE=
# Jobs: desliga o agendamento BullMQ (útil em testes). false = handlers rodam inline, sem Redis
JOBS_ENABLED=true
# Prefixo das chaves BullMQ no Redis (isola ambientes que compartilham o mesmo Redis)
BULLMQ_PREFIX=bull
# Logs (pino): fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Hash dos códigos OTP (vazio = usa JWT_ACCESS_SECRET); máx. de e-mails OTP por endereço a cada 15 min
OTP_HASH_SECRET=
OTP_MAX_REQUESTS_PER_WINDOW=5
# Versão dos termos/política registrada como consentimento (LGPD) no primeiro login
TERMS_VERSION=2026-11
# Rate limiting por usuário/IP (por minuto); rotas /auth/otp/* usam o limite mais estrito
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_OTP_PER_MINUTE=5
# iCal: timeout, tamanho máximo, falhas seguidas até marcar ERROR (RF-22)
ICAL_FETCH_TIMEOUT_MS=10000
ICAL_MAX_BYTES=2000000
ICAL_ERROR_THRESHOLD=3
# Permite links iCal em IPs privados/localhost (vazio = permitido fora de produção; nunca em produção)
ICAL_ALLOW_PRIVATE_HOSTS=

# ---------- Integrações (vazio = adapter fake) ----------
EMAIL_PROVIDER=fake            # fake | resend | velomail
RESEND_API_KEY=
# Chave padrão re_... do VeloMail (a chave uai_ do MCP não envia e-mail)
VELOMAIL_API_KEY=
VELOMAIL_BASE_URL=https://www.velomail.com.br/api
EMAIL_FROM="Precisari <ola@precisari.com.br>"
HOLIDAYS_PROVIDER=brasilapi    # brasilapi | fake
BRASILAPI_BASE_URL=https://brasilapi.com.br/api
WEATHER_PROVIDER=open-meteo    # open-meteo | fake
OPEN_METEO_BASE_URL=https://api.open-meteo.com
GEO_PROVIDER=fake              # google | fake
GOOGLE_MAPS_API_KEY=
LLM_PROVIDER=fake              # anthropic | fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
PUSH_PROVIDER=fake             # expo | fake
EXPO_ACCESS_TOKEN=
BILLING_PROVIDER=fake          # fake | asaas
# Em .env, mantenha a chave entre aspas simples: ela começa com $
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3
# 32 a 255 caracteres, nunca a API key (openssl rand -hex 32)
ASAAS_WEBHOOK_TOKEN=
BILLING_WEBHOOK_SECRET=change-me-webhook-secret
CHANNEX_PROVIDER=fake          # channex | fake (fase 2)
CHANNEX_BASE_URL=https://staging.channex.io/api/v1
CHANNEX_API_KEY=
# Segredo aleatório que o Channex envia no header x-precisari-secret dos webhooks de reserva
CHANNEX_WEBHOOK_SECRET=
SENTRY_DSN=
# Popula dados curados (feriados estaduais/municipais, férias escolares) e feriados nacionais no boot se vazios
DATA_SEED_ON_BOOT=true
# Login social (TODO: credenciais)
APPLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# ---------- Web (apps/web) ----------
NEXT_PUBLIC_API_URL=http://localhost:3333

# ---------- Mobile (apps/mobile) ----------
EXPO_PUBLIC_API_URL=http://localhost:3333
